{
  "name": "benrey-support-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Support Ticket Tracker admin built on Payload CMS 3",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "^10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:prod": "pnpm migrate && next start",
    "migrate": "tsx src/scripts/migrate.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "tsx src/seed/index.ts",
    "r2:cors": "tsx src/scripts/setR2Cors.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "dotenv": "16.4.7",
    "next": "16.4.2",
    "payload": "3.93.0",
    "qs-esm": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.34.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.20.0",
    "prettier": "3.9.10",
    "sass": "1.77.4",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
