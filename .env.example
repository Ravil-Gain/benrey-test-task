# Copy this file to .env and fill in real values. Never commit .env.

# Neon PostgreSQL connection string (dev branch locally, production branch on Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used by Payload to sign sessions and tokens
PAYLOAD_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (S3-compatible). Bucket must be private.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Seed accounts (used only by `pnpm seed`). Passwords: at least 12 characters.
SEED_ADMIN_EMAIL=admin@support.example.test
SEED_ADMIN_PASSWORD=replace-with-a-password-of-12-plus-chars
SEED_AGENT_PASSWORD=replace-with-a-password-of-12-plus-chars
