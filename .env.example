# Copy this file to .env and fill in real values. Never commit .env.

# Neon PostgreSQL connection string (dev branch locally, production branch on Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used by Payload to sign sessions and tokens
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public origin of the app, no path. Local: http://localhost:3000.
# Production: https://<service-name>.onrender.com (https is required in production).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible). Bucket must be private.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Groq API key for the AI field help (optional). Without it the help says "not set up"
# and the admin keeps working. Create one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override. Default: openai/gpt-oss-20b
GROQ_MODEL=

# Seed accounts (used only by `pnpm seed`). Passwords: at least 12 characters.
SEED_ADMIN_EMAIL=admin@support.example.test
SEED_ADMIN_PASSWORD=replace-with-a-password-of-12-plus-chars
SEED_AGENT_PASSWORD=replace-with-a-password-of-12-plus-chars
